# ---------------------------------------------------------------------------
# Zerto -> VCF seed migration toolset configuration
#
# Copy this file to `.env` and replace the placeholder values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Zerto ZVMA (used by 01_zerto_discover_and_export.py) ------------------
# IP address or FQDN of the Zerto Virtual Manager Appliance (no scheme).
ZVM_IP=10.0.0.1

# Keycloak OAuth client created in the `zerto` realm.
# See keycloak.md for how to create this client and retrieve the secret.
ZVM_CLIENT_ID=zerto-python-script
ZVM_CLIENT_SECRET=replace-with-your-keycloak-client-secret

# --- vCenter (used by 02_vcf_seed_copy.py) ---------------------------------
# IP address or FQDN of the vCenter Server (no scheme).
VCENTER_IP=10.0.0.2

# Account needs the Datastore.FileManagement privilege.
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=replace-with-your-vcenter-password

# Name of the vCenter Datacenter object holding the target datastores.
VCENTER_DATACENTER=Datacenter-DR

# --- Shared / optional -----------------------------------------------------
# Manifest file passed from script 01 to script 02.
MANIFEST_FILE=zerto_seeds_manifest.json

# Set to true only if ZVM and vCenter present trusted (non self-signed) certs.
VERIFY_SSL=false
